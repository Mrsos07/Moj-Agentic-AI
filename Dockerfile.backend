# ─── الخادم الخلفي لموج — صورة إنتاج ───
# عملية واحدة (python run.py, RELOAD=0) تشغّل FastAPI وتُطلق داخلها خوادم X (5789) وLoginX (5000)
# وIdentity (5990). لا تشغّل أكثر من نسخة: ذاكرة الرسم والطابور والمنافذ مصمّمة لعملية واحدة.
FROM python:3.13-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    TZ=Asia/Riyadh

# أدوات البناء لمكتبات بايثون ذات الامتدادات + curl لفحص الصحة + tini لإنهاء العمليات الفرعية بنظافة
# + nodejs (≥20، من مستودع Debian): خادما نواه (الاستنساخ والتوجيه الإعلامي) MCP عبر stdio يُشغَّلان بـ
#   «node <ملف .mjs مجمّع>» — بدونه في الإنتاج: «Node.js غير مثبّت» (قيس 2026-11-16)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl ca-certificates tini tzdata lsof fonts-noto-core fonts-noto-color-emoji nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# متصفح Patchright (مسارات X الخفية) + مكتبات النظام التي يحتاجها، في مسار مشترك يقرؤه المستخدم غير الجذر
RUN patchright install --with-deps chromium \
    && playwright install chromium \
    && chmod -R a+rX /ms-playwright

COPY . .

# مستخدم غير جذر؛ المجلدات الدائمة مملوكة له (الأحجام المسمّاة ترث الملكية عند إنشائها أول مرة).
# u+w: النسخ من Windows/OneDrive ينقل المجلدات للقراءة فقط (dr-xr-xr-x) — قيس: loginx توقف عند
# الإقلاع بـPermissionError على app/x/loginx/uploads.
RUN useradd --create-home --uid 1000 moj \
    && mkdir -p data/schedule_outputs app/x/cookies app/x/loginx/uploads app/identity/static/generated \
                static/uploads frontend/dist \
    && chown -R moj:moj /app && chmod -R u+w /app
USER moj

ENV RELOAD=0 \
    BIND_HOST=0.0.0.0 \
    PORT=8000 \
    NEO4J_AUTOSTART=0

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "python init_database.py && exec python run.py"]
