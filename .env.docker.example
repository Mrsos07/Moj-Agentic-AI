# ════════════════════════════════════════════════════════════════
#         ملف البيئة لتشغيل موج بالدوكر (إنتاج) — انسخه إلى .env
#         cp .env.docker.example .env   ثم:   docker compose up -d --build
# ════════════════════════════════════════════════════════════════
# ⚠️ احفظه UTF-8 (لا UTF-16): PowerShell «>» وNotepad القديم يكسران load_dotenv.

# ─── التطبيق ───
APP_NAME=موج
DEBUG=False
# النطاق العام (سجل A يشير لعنوان الخادم). مضبوط ⇒ HTTPS تلقائي بشهادة Let's Encrypt.
# فارغ ⇒ HTTP فقط على عنوان IP (للتجربة — لا تُدخل كلمات مرور حقيقية بلا HTTPS).
DOMAIN=moj.example.com
# Optional HTTPS origin for private Telegram callbacks. Defaults to https://DOMAIN.
TELEGRAM_WEBHOOK_BASE_URL=
# النطاق نفسه بالبروتوكول (CORS + فحص Origin للـWebSocket). بلا شرطة أخيرة، عدة قيم بفواصل.
# بلا نطاق: http://عنوان_الخادم
ALLOWED_ORIGINS=https://moj.example.com
# منافذ caddy العامة على الخادم
HTTP_PORT=80
HTTPS_PORT=443
# التسجيل الذاتي من صفحة «إنشاء حساب». false في الإنتاج: المشرف يُنشئ الحسابات بـ
#   docker compose exec backend python scripts/create_user.py --email ... [--role admin]
ALLOW_REGISTRATION=false

# ─── مفاتيح الأمان (إلزامية — لا تبدأ بدونها) ───
# openssl rand -hex 32
JWT_SECRET_KEY=غيّر_هذا_بمفتاح_عشوائي_طويل
JWT_ALGORITHM=HS256
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=غيّر_هذا_بمفتاح_Fernet_صالح
# اختياري: مفتاح منفصل لتوقيع الاستدعاءات الداخلية (وإلا يُشتق من JWT_SECRET_KEY)
INTERNAL_CALLBACK_SECRET=

# ─── قاعدة الرسم Neo4j (حاوية neo4j) — كلمة مرور قوية ≥ 8 أحرف ───
NEO4J_PASSWORD=غيّر_هذا_بكلمة_مرور_قوية

# ─── قاعدة البيانات: SQLite افتراضياً (data/app.db في الحجم moj_data) ───
# PostgreSQL (اختياري، دليل_الدوكر.txt ← «التحويل إلى PostgreSQL»): أزل # من السطرين.
# كلمة المرور حروف وأرقام فقط (تدخل في رابط الاتصال): openssl rand -hex 24
# COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml
# (ويندوز: الفاصل «;» افتراضياً — أضف COMPOSE_PATH_SEPARATOR=: أو استخدم «;»)
# POSTGRES_PASSWORD=
# حدود الاتصال (PostgreSQL فقط؛ القيم الافتراضية مناسبة لعملية خلفية واحدة):
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# قفل متفائل للموظفين (دمج ثلاثي بدل الكتابة فوق تعديل متزامن) — تجريبي، معطّل افتراضياً
# DB_OPTIMISTIC_LOCKING=0

# ─── وقت تشغيل الموظفين (AEOS) ───
# legacy (الافتراضي) = الطابور في الذاكرة كما كان. durable = الطابور الدائم في القاعدة (execution_jobs):
# عقود برمز سياج، نبض واستعادة، إعادة محاولة وDLQ، إلغاء ومهل وحدود للدورة، سجل أفعال قبل/بعد كل فعل
# على X، وحارس مغلق عند الفشل. التفاصيل: AGENTS.md ← «Durable AEOS runtime».
# AEOS_RUNTIME=durable
# AEOS_WORKERS=4
# AEOS_TENANT_MAX_ACTIVE=2
# AEOS_LEASE_SECONDS=120
# AEOS_HEARTBEAT_SECONDS=20
# AEOS_CYCLE_DEADLINE_SECONDS=1800
# AEOS_MAX_ATTEMPTS=3
# AEOS_MAX_LLM_CALLS=60
# AEOS_MAX_TOOL_CALLS=40
# AEOS_QUEUE_MAX_DEPTH=500

# ─── مزوّد النماذج: OpenRouter (المفضّل) — اسم الموديل مؤهَّل بالمزوّد ───
OPENROUTER_API_KEY=sk-or-v1-ضع_مفتاحك_هنا
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
# احتياط: OpenAI مباشرة (فقط لو غاب OpenRouter)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─── البحث والميديا ───
TAVILY_API_KEY=
# صور/فيديو مجانية للمنشورات (مهارة stock_media) — مجاني من https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# توليد الهويات (Identity): يعمل بمفتاح OpenRouter نفسه (النص بنموذج النظام، والصور بـ GPT Image).
# اختياري: نموذج صور آخر من OpenRouter (الافتراضي openai/gpt-5.4-image-2)
IDENTITY_IMAGE_MODEL=

# ─── البروكسي السكني للسعودية (اختياري لكن موصى به لمسارات X) ───
PROXY_PROVIDER=
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_COUNTRY=sa
PROXY_CITY=
PROXY_ROTATE=session

# ─── حل الكابتشا (اختياري — يحتاجه تسجيل دخول X ونشر بعض الحسابات) ───
# مفتاح واحد يكفي؛ CAPTCHA_PROVIDER فارغ = أول مفتاح موجود
CAPTCHA_PROVIDER=
YESCAPTCHA_KEY=
TWOCAPTCHA_KEY=
CAPMONSTER_KEY=
ANTICAPTCHA_KEY=

# أمن الوكلاء. مفتاح مستقل وعشوائي لسجل القرارات والموافقات. احفظ نسخة محمية منه.
AGENT_SECURITY_KEY=
# ملف JSON داخل الحاوية بسياسات tenant/user/agent/workspace، بمسار يختاره المشغّل.
AGENT_SECURITY_POLICY=
# مفاتيح Fernet السابقة للقراءة خلال تدوير مفتاح التشفير، تفصلها فاصلة.
AEOS_PREVIOUS_ENCRYPTION_KEYS=
# الوجهات الداخلية التي يوافق عليها المشغّل لخوادم MCP النظامية فقط.
MCP_INTERNAL_ORIGINS=
# مفتاح منفصل مشترك للتحقق من توقيع webhooks الصادرة.
N8N_WEBHOOK_SIGNING_KEY=

# عند تحديد هذه القائمة يقتصر جلب الصفحات والوسائط وHTTP MCP على أسماء المضيفين المطابقة تمامًا.
AGENT_EGRESS_HOSTS=
