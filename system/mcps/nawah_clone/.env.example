# Standalone use only (Claude Desktop / Cursor). Inside the Moj project these values are passed in the
# environment by app/aeos/services/nawah_clone.py from the project's own .env — do not create a .env here.

# Required: an OpenAI-compatible endpoint. OpenRouter by default.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: model names, PROVIDER-QUALIFIED (defaults shown). An unqualified name is a 404 on OpenRouter.
# NAWAH_MODEL=google/gemini-3.7-flash
# NAWAH_FALLBACK_MODEL=google/gemini-3.6-flash

# Optional: web research before writing (the «بحث وأدلة» and «ساخر» modes, research="web").
TAVILY_API_KEY=

# Optional: press research through newsdata.io
NEWSDATA_API_KEY=

# Optional: where clone files live (default: ./data next to this file)
NAWAH_DATA_DIR=
