# ============================================================================
# كنق الاتمته - Chatbot Configuration
# ============================================================================

# Application Settings
APP_NAME=كنق الاتمته - Chatbot
VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ── LLM: OpenRouter (المزوّد الأساسي) ───────────────────────────────────────
# أسماء الموديلات في OpenRouter مؤهَّلة بالمزوّد: "openai/gpt-4o-mini" لا "gpt-4".
# الاسم غير المؤهَّل يُرفض ويعيد رداً فارغاً بصمت من كل مسارات الاستدلال.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# لا تغيّر موديل الـ embeddings بلا سبب: تغييره يغيّر أبعاد المتجهات فتصبح كل
# بيانات ذاكرة الرسم البياني الحالية غير قابلة للبحث الدلالي وتحتاج إعادة بناء.
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_IMAGE_MODEL=openai/gpt-image-1
# OPENROUTER_SITE_URL=https://example.com   # ترويسة HTTP-Referer (اختياري)
# OPENROUTER_APP_NAME=Moj-Agentic-AI        # ترويسة X-Title (اختياري)

# ── Tavily: المزوّد الوحيد للبحث وجمع الترندات (بحث الويب + كاشف الترندات) ──
# TAVILY_API_KEY=tvly-...
# TREND_TAVILY_INTERVAL=240     # اختياري: كل كم دقيقة يجمع كاشف الترندات (يستهلك رصيد Tavily)
# TOPIC_SEMANTIC=0              # اختياري: تعطيل التحليل الدلالي (يبقى تحليل الكلمات)

# حدود مشتركة بين المزوّدين (الأسماء محفوظة للتوافق مع .env القديم)
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ── احتياط: OpenAI مباشرة ───────────────────────────────────────────────────
# يُستخدم فقط إذا كان OPENROUTER_API_KEY فارغاً. لو المفتاحان موجودان يفوز
# OpenRouter دائماً.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=chatbot_db

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=chatbot_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Graph memory (Zep/Graphiti + embedded Kuzu) for the AI employee
# GRAPHITI_ENABLED=1              # 0 to disable the temporal knowledge graph
# GRAPHITI_KUZU_DB=data/graphiti_kuzu
# GRAPHITI_MIN_SCORE=0.3          # min semantic similarity for hybrid search

# ============================================================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env file to version control
# ============================================================================
